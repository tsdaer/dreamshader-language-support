<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.tsdaer.dreamshaderlanguagesupport</id>
    <name>Dreamshader Language Extension</name>
    <vendor>tsdaer</vendor>
    <resource-bundle>messages.DreamShaderBundle</resource-bundle>
    <depends>com.intellij.modules.platform</depends>
    <description><![CDATA[
        <p>Comprehensive DreamShaderLang support for JetBrains Rider with <code>.dsm</code>/<code>.dsf</code>/<code>.dsh</code> file types, lexer/parser/PSI and symbol model foundations, syntax highlighting plus semantic classification and color settings, formatter/commenter/brace matching/folding/structure view, context-aware completion (sections/types/settings values/UE.*/HLSL/imports), and goto declaration/find usages/references/hover docs/signature help.</p>
        <p>Includes semantic diagnostics (syntax/section-shape/semantic + Bridge diagnostics mapping), inlay parameter hints and Code Vision hints, configurable DreamShader project settings (project root/manifest path/status bar/code lens/out placeholder suffix/import extension strategy/hover doc overrides/Bridge commands), Bridge tool window and workflow actions (refresh diagnostics/recompile current or all/clean generated shaders/open Bridge paths), package tooling (package store dialog with search/filter/details/install-state markers/background install-update-remove/add-remove index sources/GitHub install/update/remove/open packages folder/package-aware import resolution), template tools (material/function/header and package scaffold), and unified DreamShader Hub entry for settings, diagnostics, package, and template workflows.</p>
    ]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="DreamShaderLang"
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.core.DreamShaderFileType"
                fieldName="INSTANCE"
                extensions="dsm;dsf;dsh"/>
        <lang.syntaxHighlighterFactory
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.highlighting.DreamShaderSyntaxHighlighterFactory"/>
        <lang.parserDefinition
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.parser.DreamShaderParserDefinition"/>
        <lang.formatter
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderFormattingModelBuilder"/>
        <codeStyleSettingsProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderCodeStyleSettingsProvider"/>
        <langCodeStyleSettingsProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderLanguageCodeStyleSettingsProvider"/>
        <lang.commenter
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderCommenter"/>
        <lang.quoteHandler
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderQuoteHandler"/>
        <lang.braceMatcher
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderBraceMatcher"/>
        <lang.smartEnterProcessor
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderSmartEnterProcessor"/>
        <lang.foldingBuilder
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderFoldingBuilder"/>
        <lang.psiStructureViewFactory
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderStructureViewFactory"/>
        <referencesSearch
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderReferencesSearchExecutor"/>
        <gotoDeclarationHandler
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderGotoDeclarationHandler"/>
        <gotoClassContributor
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderGotoClassContributor"/>
        <gotoSymbolContributor
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderGotoSymbolContributor"/>
        <lang.findUsagesProvider
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderFindUsagesProvider"/>
        <lang.namesValidator
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.refactoring.DreamShaderNamesValidator"/>
        <renameInputValidator
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.refactoring.DreamShaderRenameInputValidator"/>
        <lang.refactoringSupport
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.refactoring.DreamShaderRefactoringSupportProvider"/>
        <lang.documentationProvider
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderDocumentationProvider"/>
        <breadcrumbsInfoProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderBreadcrumbsInfoProvider"/>
        <declarationRangeHandler
                key="com.github.tsdaer.dreamshaderlanguagesupport.language.psi.impl.DreamShaderDeclarationImpl"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderDeclarationRangeHandler"/>
        <declarationRangeHandler
                key="com.github.tsdaer.dreamshaderlanguagesupport.language.psi.impl.DreamShaderSectionImpl"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderDeclarationRangeHandler"/>
        <qualifiedNameProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderQualifiedNameProvider"/>
        <nameSuggestionProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderNameSuggestionProvider"/>
        <annotator
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.diagnostics.DreamShaderSemanticAnnotator"/>
        <include.provider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderFileIncludeProvider"/>
        <completion.contributor
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderCompletionContributor"/>
        <typedHandler
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderCompletionTypedHandler"/>
        <completion.plainTextSymbol
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderPlainTextSymbolCompletionContributor"/>
        <codeInsight.lineMarkerProvider
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderLineMarkerProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderCodeVisionProvider"/>
        <codeInsight.parameterInfo
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderParameterInfoHandler"/>
        <codeInsight.parameterNameHints
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderInlayParameterHintsProvider"/>
        <colorSettingsPage
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.highlighting.DreamShaderColorSettingsPage"/>
        <colorProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderColorProvider"/>
        <spellchecker.support
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderSpellcheckingStrategy"/>
        <fileTemplateGroup
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderFileTemplateGroupFactory"/>
        <defaultTemplatePropertiesProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderDefaultTemplatePropertiesProvider"/>
        <liveTemplateContext
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderLiveTemplateContext"/>
        <defaultLiveTemplatesProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderLiveTemplatesProvider"/>
        <codeInsight.template.postfixTemplateProvider
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderPostfixTemplateProvider"/>
        <projectConfigurable
                id="dreamshader.settings"
                groupId="tools"
                key="projectConfigurable.dreamshader.displayName"
                bundle="messages.DreamShaderBundle"
                instance="com.github.tsdaer.dreamshaderlanguagesupport.language.settings.DreamShaderSettingsConfigurable"/>
        <notificationGroup id="DreamShader Notifications" displayType="BALLOON"/>
        <toolWindow id="DreamShader Bridge Diagnostics"
                    anchor="bottom"
                    icon="/icons/dreamshaderToolWindow.svg"
                    factoryClass="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderBridgeToolWindowFactory"
                    canCloseContents="false"/>
        <toolWindow id="DreamShader Material Preview"
                    anchor="right"
                    icon="/icons/dreamshaderToolWindow.svg"
                    factoryClass="com.github.tsdaer.dreamshaderlanguagesupport.language.preview.DreamShaderMaterialPreviewToolWindowFactory"
                    canCloseContents="false"/>
        <statusBarWidgetFactory
                id="DreamShaderBridgeStatus"
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderBridgeStatusBarWidgetFactory"/>
        <fileEditorProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.welcome.DreamShaderWelcomeFileEditorProvider"
                dumbAware="true"/>
        <postStartupActivity
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.welcome.DreamShaderWelcomeProjectActivity"/>
        <postStartupActivity
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderBridgeFileWatcher"/>
    </extensions>

    <actions>
        <group id="DreamShader.Tools.Group"
               text="DreamShader"
               description="DreamShader tools and workflows"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="DreamShader.Tools.OpenHub"
                    class="com.github.tsdaer.dreamshaderlanguagesupport.language.settings.DreamShaderOpenHubAction"/>
            <action id="DreamShader.Tools.ShowMaterialPreview"
                    class="com.github.tsdaer.dreamshaderlanguagesupport.language.preview.DreamShaderShowMaterialPreviewAction"/>

            <separator/>

            <group id="DreamShader.BridgeTools.Group"
                   text="DreamShader Bridge"
                   description="DreamShader Bridge diagnostics actions"
                   popup="true">
                <action id="DreamShader.BridgeTools.RefreshDiagnostics"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderRefreshBridgeDiagnosticsAction"/>
                <action id="DreamShader.BridgeTools.RecompileCurrent"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderRecompileCurrentAction"/>
                <action id="DreamShader.BridgeTools.RecompileAll"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderRecompileAllAction"/>
                <action id="DreamShader.BridgeTools.CleanGeneratedShaders"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderCleanGeneratedShadersAction"/>
                <action id="DreamShader.BridgeTools.OpenBridgeDirectory"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderOpenBridgeDirectoryAction"/>
                <action id="DreamShader.BridgeTools.OpenDiagnosticsFile"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderOpenBridgeDiagnosticsFileAction"/>
                <action id="DreamShader.BridgeTools.OpenFirstDiagnosticLocation"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderOpenFirstBridgeDiagnosticLocationAction"/>
            </group>

            <group id="DreamShader.PackageTools.Group"
                   text="DreamShader Packages"
                   description="DreamShader package management actions"
                   popup="true">
                <action id="DreamShader.PackageTools.BrowseStore"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderBrowsePackageStoreAction"/>

                <separator/>

                <action id="DreamShader.PackageTools.InstallFromGitHub"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderInstallPackageFromGitHubAction"/>
                <action id="DreamShader.PackageTools.UpdateInstalled"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderUpdateInstalledPackageAction"/>
                <action id="DreamShader.PackageTools.RemoveInstalled"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderRemoveInstalledPackageAction"/>
                <action id="DreamShader.PackageTools.OpenPackagesFolder"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderOpenPackagesFolderAction"/>

                <separator/>

                <action id="DreamShader.PackageTools.AddIndexSource"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderAddPackageIndexSourceAction"/>
                <action id="DreamShader.PackageTools.RemoveIndexSource"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderRemovePackageIndexSourceAction"/>
            </group>

            <group id="DreamShader.TemplateTools.Group"
                   text="DreamShader Templates"
                   description="DreamShader template and scaffold actions"
                   popup="true">
                <action id="DreamShader.TemplateTools.CreateMaterial"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateMaterialTemplateAction"/>
                <action id="DreamShader.TemplateTools.CreateFunction"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateFunctionTemplateAction"/>
                <action id="DreamShader.TemplateTools.CreateHeader"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateHeaderTemplateAction"/>
                <action id="DreamShader.TemplateTools.CreateTextureSample"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateTextureSampleTemplateAction"/>
                <action id="DreamShader.TemplateTools.CreateNoiseMaterial"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateNoiseMaterialTemplateAction"/>

                <separator/>

                <action id="DreamShader.TemplateTools.CreatePackageWizard"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreatePackageWizardAction"/>
                <action id="DreamShader.TemplateTools.CreatePackageScaffold"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreatePackageScaffoldAction"/>
            </group>
        </group>

        <action id="DreamShader.NewFile"
                class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateFileFromTemplateAction">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
