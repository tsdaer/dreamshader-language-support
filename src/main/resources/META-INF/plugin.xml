<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.tsdaer.dreamshaderlanguagesupport</id>
    <name>Dreamshader Language Extension</name>
    <vendor>tsdaer</vendor>
    <resource-bundle>messages.DreamShaderBundle</resource-bundle>
    <depends>com.intellij.modules.platform</depends>
    <description><![CDATA[
        <p>DreamShaderLang language support for JetBrains Rider.</p>
        <p>Current features include file type registration for <code>.dsm</code>, <code>.dsf</code>, and <code>.dsh</code>, syntax highlighting, comment support, and paired braces.</p>
    ]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="DreamShaderLang"
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.core.DreamShaderFileType"
                fieldName="INSTANCE"
                extensions="dsm;dsf;dsh"/>
        <lang.syntaxHighlighterFactory
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.highlighting.DreamShaderSyntaxHighlighterFactory"/>
        <lang.parserDefinition
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.parser.DreamShaderParserDefinition"/>
        <lang.formatter
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderFormattingModelBuilder"/>
        <lang.commenter
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderCommenter"/>
        <lang.braceMatcher
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderBraceMatcher"/>
        <lang.foldingBuilder
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderFoldingBuilder"/>
        <lang.psiStructureViewFactory
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderStructureViewFactory"/>
        <referencesSearch
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderReferencesSearchExecutor"/>
        <gotoDeclarationHandler
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderGotoDeclarationHandler"/>
        <lang.findUsagesProvider
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderFindUsagesProvider"/>
        <lang.documentationProvider
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.navigation.DreamShaderDocumentationProvider"/>
        <annotator
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.diagnostics.DreamShaderSemanticAnnotator"/>
        <completion.contributor
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderCompletionContributor"/>
        <codeInsight.daemonBoundCodeVisionProvider
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderCodeVisionProvider"/>
        <codeInsight.parameterInfo
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderParameterInfoHandler"/>
        <codeInsight.parameterNameHints
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.editor.DreamShaderInlayParameterHintsProvider"/>
        <colorSettingsPage
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.highlighting.DreamShaderColorSettingsPage"/>
        <projectConfigurable
                id="dreamshader.settings"
                groupId="tools"
                key="projectConfigurable.dreamshader.displayName"
                bundle="messages.DreamShaderBundle"
                instance="com.github.tsdaer.dreamshaderlanguagesupport.language.settings.DreamShaderSettingsConfigurable"/>
        <notificationGroup id="DreamShader Notifications" displayType="BALLOON"/>
        <toolWindow id="DreamShader Bridge Diagnostics"
                    anchor="bottom"
                    icon="/icons/dreamshaderToolWindow.svg"
                    factoryClass="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderBridgeToolWindowFactory"
                    canCloseContents="false"/>
        <statusBarWidgetFactory
                id="DreamShaderBridgeStatus"
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderBridgeStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <group id="DreamShader.Tools.Group"
               text="DreamShader"
               description="DreamShader tools and workflows"
               popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="DreamShader.Tools.OpenHub"
                    class="com.github.tsdaer.dreamshaderlanguagesupport.language.settings.DreamShaderOpenHubAction"/>

            <separator/>

            <group id="DreamShader.BridgeTools.Group"
                   text="DreamShader Bridge"
                   description="DreamShader Bridge diagnostics actions"
                   popup="true">
                <action id="DreamShader.BridgeTools.RefreshDiagnostics"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderRefreshBridgeDiagnosticsAction"/>
                <action id="DreamShader.BridgeTools.RecompileCurrent"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderRecompileCurrentAction"/>
                <action id="DreamShader.BridgeTools.RecompileAll"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderRecompileAllAction"/>
                <action id="DreamShader.BridgeTools.CleanGeneratedShaders"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderCleanGeneratedShadersAction"/>
                <action id="DreamShader.BridgeTools.OpenBridgeDirectory"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderOpenBridgeDirectoryAction"/>
                <action id="DreamShader.BridgeTools.OpenDiagnosticsFile"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderOpenBridgeDiagnosticsFileAction"/>
                <action id="DreamShader.BridgeTools.OpenFirstDiagnosticLocation"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.bridge.DreamShaderOpenFirstBridgeDiagnosticLocationAction"/>
            </group>

            <group id="DreamShader.PackageTools.Group"
                   text="DreamShader Packages"
                   description="DreamShader package management actions"
                   popup="true">
                <action id="DreamShader.PackageTools.BrowseStore"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderBrowsePackageStoreAction"/>

                <separator/>

                <action id="DreamShader.PackageTools.InstallFromGitHub"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderInstallPackageFromGitHubAction"/>
                <action id="DreamShader.PackageTools.UpdateInstalled"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderUpdateInstalledPackageAction"/>
                <action id="DreamShader.PackageTools.RemoveInstalled"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderRemoveInstalledPackageAction"/>
                <action id="DreamShader.PackageTools.OpenPackagesFolder"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderOpenPackagesFolderAction"/>

                <separator/>

                <action id="DreamShader.PackageTools.AddIndexSource"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderAddPackageIndexSourceAction"/>
                <action id="DreamShader.PackageTools.RemoveIndexSource"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.packages.DreamShaderRemovePackageIndexSourceAction"/>
            </group>

            <group id="DreamShader.TemplateTools.Group"
                   text="DreamShader Templates"
                   description="DreamShader template and scaffold actions"
                   popup="true">
                <action id="DreamShader.TemplateTools.CreateMaterial"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateMaterialTemplateAction"/>
                <action id="DreamShader.TemplateTools.CreateFunction"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateFunctionTemplateAction"/>
                <action id="DreamShader.TemplateTools.CreateHeader"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreateHeaderTemplateAction"/>

                <separator/>

                <action id="DreamShader.TemplateTools.CreatePackageScaffold"
                        class="com.github.tsdaer.dreamshaderlanguagesupport.language.templates.DreamShaderCreatePackageScaffoldAction"/>
            </group>
        </group>
    </actions>
</idea-plugin>
