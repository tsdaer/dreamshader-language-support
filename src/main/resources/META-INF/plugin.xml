<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.tsdaer.dreamshaderlanguagesupport</id>
    <name>Dreamshader Language Extension</name>
    <vendor>tsdaer</vendor>
    <description><![CDATA[
        <p>DreamShaderLang language support for JetBrains Rider.</p>
        <p>Current features include file type registration for <code>.dsm</code>, <code>.dsf</code>, and <code>.dsh</code>, syntax highlighting, comment support, and paired braces.</p>
    ]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="DreamShaderLang"
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderFileType"
                fieldName="INSTANCE"
                extensions="dsm;dsf;dsh"/>
        <lang.syntaxHighlighterFactory
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderSyntaxHighlighterFactory"/>
        <lang.parserDefinition
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderParserDefinition"/>
        <lang.commenter
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderCommenter"/>
        <lang.braceMatcher
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderBraceMatcher"/>
        <lang.foldingBuilder
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderFoldingBuilder"/>
        <lang.psiStructureViewFactory
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderStructureViewFactory"/>
        <referencesSearch
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderReferencesSearchExecutor"/>
        <gotoDeclarationHandler
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderGotoDeclarationHandler"/>
        <lang.findUsagesProvider
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderFindUsagesProvider"/>
        <lang.documentationProvider
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderDocumentationProvider"/>
        <annotator
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderSemanticAnnotator"/>
        <completion.contributor
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderCompletionContributor"/>
        <codeInsight.parameterInfo
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderParameterInfoHandler"/>
        <codeInsight.parameterNameHints
                language="DreamShaderLang"
                implementationClass="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderInlayParameterHintsProvider"/>
        <colorSettingsPage
                implementation="com.github.tsdaer.dreamshaderlanguagesupport.language.DreamShaderColorSettingsPage"/>
    </extensions>
</idea-plugin>
